{{!< default}}

{{!-- Template "Membership": the page content, then your paid tiers with a Portal sign-up button each. --}}
{{#post}}
<article class="{{post_class}} article">
    <header class="article-header container">
        {{> breadcrumbs}}
        <h1 class="article-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="article-excerpt">{{custom_excerpt}}</p>{{/if}}
    </header>
    {{#if content}}<div class="gh-content" data-table-label="{{t "Scrollable table"}}" data-copy="{{t "Copy"}}" data-copied="{{t "Copied"}}" data-anchor-label="{{t "Copy link to this section"}}" data-zoom-label="{{t "Zoom image"}}" data-close-label="{{t "Close"}}" data-prev-label="{{t "Previous"}}" data-next-label="{{t "Next"}}">{{content}}</div>{{/if}}
</article>
{{/post}}

{{#get "tiers" filter="type:paid" include="monthly_price,yearly_price,benefits" limit="6" as |tiers|}}
    {{#if tiers}}
        <section class="container section tiers" aria-label="{{t "Membership"}}">
            {{#foreach tiers}}
                <div class="tile tier">
                    <h2 class="tier-name">{{name}}</h2>
                    {{#if description}}<p class="tier-description">{{description}}</p>{{/if}}
                    {{#if monthly_price}}
                        <p class="tier-price"><span class="tier-amount">{{price monthly_price currency=currency}}</span> <span class="tier-period">/ {{t "month"}}</span></p>
                    {{else}}
                        {{#if yearly_price}}<p class="tier-price"><span class="tier-amount">{{price yearly_price currency=currency}}</span> <span class="tier-period">/ {{t "year"}}</span></p>{{/if}}
                    {{/if}}
                    {{#if benefits}}<ul class="tier-benefits">{{#foreach benefits}}<li>{{> "icons/check"}}<span>{{this}}</span></li>{{/foreach}}</ul>{{/if}}
                    {{#if monthly_price}}
                        <a class="button" href="#/portal/signup/{{id}}/monthly" data-portal="signup/{{id}}/monthly">{{t "Choose this plan"}}</a>
                    {{else}}
                        <a class="button" href="#/portal/signup/{{id}}/yearly" data-portal="signup/{{id}}/yearly">{{t "Choose this plan"}}</a>
                    {{/if}}
                </div>
            {{/foreach}}
        </section>
    {{/if}}
{{/get}}

{{> subscribe-form}}
