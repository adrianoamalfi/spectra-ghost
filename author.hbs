{{!< default}}

{{#author}}
<header class="container archive-header author-header">
    {{> breadcrumbs}}
    {{#if profile_image}}
        <img class="author-avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}" width="96" height="96">
    {{/if}}
    <p class="eyebrow">{{t "Author"}}</p>
    <h1 class="archive-title">{{name}}</h1>
    {{#if bio}}
        <p class="archive-description">{{bio}}</p>
    {{/if}}
    <p class="archive-count">
        {{#if location}}<span>{{location}}</span> · {{/if}}
        {{#if website}}<a href="{{website}}" rel="me noopener">{{t "Website"}}</a> · {{/if}}
        <span>{{plural count.posts empty=(t "No posts") singular=(t "1 post") plural=(t "% posts")}}</span>
    </p>
</header>
{{/author}}

<section class="container section">
    <h2 class="visually-hidden">{{t "Latest posts"}}</h2>
    {{> post-feed}}
</section>
