{{!< default}}

{{#post}}
<article class="{{post_class}} article article--note">
    <header class="article-header container-narrow note-header">
        {{> breadcrumbs}}
        <div class="article-head note-head" style="view-transition-name: card-{{id}}">
            <p class="eyebrow">{{t "Note"}}</p>
            <h1 class="article-title" style="view-transition-name: title-{{id}}">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="article-excerpt">{{custom_excerpt}}</p>
            {{/if}}
            {{> post-meta}}
        </div>
    </header>

    {{#if feature_image}}
        <figure class="article-image container-narrow note-image">
            <img
                srcset="{{img_url feature_image size="s"}} 320w,
                        {{img_url feature_image size="m"}} 640w,
                        {{img_url feature_image size="l"}} 960w"
                sizes="(min-width: 48rem) 42rem, 100vw"
                src="{{img_url feature_image size="m"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                width="{{feature_image_width}}" height="{{feature_image_height}}"
                fetchpriority="high"
            >
            {{#if feature_image_caption}}
                <figcaption>{{{feature_image_caption}}}</figcaption>
            {{/if}}
        </figure>
    {{/if}}

    <div class="article-layout container note-layout">
        <div class="article-column">
            <div class="gh-content" id="gh-content" data-table-label="{{t "Scrollable table"}}" data-copy="{{t "Copy"}}" data-copied="{{t "Copied"}}" data-anchor-label="{{t "Copy link to this section"}}" data-zoom-label="{{t "Zoom image"}}" data-close-label="{{t "Close"}}" data-prev-label="{{t "Previous"}}" data-next-label="{{t "Next"}}">
                {{content}}
            </div>
        </div>
    </div>

    {{#if tags}}
        <footer class="article-footer container-narrow">
            <ul class="tag-list">
                {{#foreach tags}}
                    <li><a href="{{url}}">{{name}}</a></li>
                {{/foreach}}
            </ul>
        </footer>
    {{/if}}

    {{> share}}
    {{> comments}}
</article>

{{> post-nav}}

{{#if @custom.show_related_posts}}
    {{> related-posts}}
{{/if}}
{{/post}}
