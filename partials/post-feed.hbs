{{!-- Optional params skip posts shown elsewhere on the first page only. --}}
<div class="feed feed--{{@custom.post_feed_style}}" data-feed-list>
    {{#match pagination.page 1}}
        {{#if skip_from}}
            {{#foreach posts from=skip_from}}
                {{#if ../skip_featured}}
                    {{#unless featured}}{{> post-card}}{{/unless}}
                {{else}}
                    {{> post-card}}
                {{/if}}
            {{else}}
                {{> empty-state}}
            {{/foreach}}
        {{else}}
            {{#foreach posts}}
                {{#if ../skip_featured}}
                    {{#unless featured}}{{> post-card}}{{/unless}}
                {{else}}
                    {{> post-card}}
                {{/if}}
            {{else}}
                {{> empty-state}}
            {{/foreach}}
        {{/if}}
    {{else}}
        {{#foreach posts}}
            {{> post-card}}
        {{else}}
            {{> empty-state}}
        {{/foreach}}
    {{/match}}
</div>

{{pagination}}
