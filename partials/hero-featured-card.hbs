<article class="tile hf-feat{{#if feature_image}} photo-ink{{/if}}">
    {{#if feature_image}}
        <img class="hero-bg" src="{{img_url feature_image size="l"}}" alt="" width="960" height="640" fetchpriority="high">
    {{/if}}
    <div class="hf-feat-body">
        <p class="hero-label">{{#if featured}}{{t "Featured"}}{{else}}{{t "Latest post"}}{{/if}}</p>
        <h2 class="hf-feat-title"><a href="{{url}}">{{title}}</a></h2>
    </div>
</article>
{{#get "posts" filter="id:-{{id}}" limit="3"}}
    {{#if posts}}
        <nav class="hf-list" aria-label="{{t "Latest posts"}}">
            {{#foreach posts}}
                <a href="{{url}}">
                    <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="D MMM YYYY"}}</time>
                    <i aria-hidden="true"></i>
                    <span>{{title}}</span>
                    <b aria-hidden="true">&rarr;</b>
                </a>
            {{/foreach}}
        </nav>
    {{/if}}
{{/get}}
