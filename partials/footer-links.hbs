<ul class="sf-links">
    {{#with @site}}
        {{#if twitter}}<li><a href="{{social_url type="twitter"}}" target="_blank" rel="noopener">{{> "icons/x"}}<span>X</span></a></li>{{/if}}
        {{#if facebook}}<li><a href="{{social_url type="facebook"}}" target="_blank" rel="noopener">{{> "icons/facebook"}}<span>Facebook</span></a></li>{{/if}}
    {{/with}}
    <li><a href="{{@site.url}}/rss/">{{> "icons/rss"}}<span>RSS</span></a></li>
</ul>
