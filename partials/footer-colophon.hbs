<footer class="site-footer site-footer--colophon">
    <div class="sf-wrap">
        <div class="sf-top">
            <div class="sf-id">
                <p class="sf-name">{{@site.title}}</p>
                {{#if @custom.footer_text}}
                    <p class="sf-text">{{@custom.footer_text}}</p>
                {{else}}
                    {{#if @site.description}}<p class="sf-text">{{@site.description}}</p>{{/if}}
                {{/if}}
                {{#if @site.donations_enabled}}<a class="button button-small button-ghost sf-support" href="#/portal/support" data-portal="support">{{t "Support this site"}}</a>{{/if}}
            </div>
            <nav class="sf-nav" aria-label="{{t "Footer"}}">
                {{navigation type="secondary"}}
            </nav>
            <nav class="sf-social" aria-label="{{t "Follow"}}">
                {{> footer-links}}
            </nav>
        </div>
        {{recommendations limit="4"}}
        <div class="sf-base">
            <p>&copy; {{date format="YYYY"}} {{@site.title}}</p>
            <div class="sf-credits">
                <p>{{t "Theme"}} <a href="https://adrianoamalfi.com/spectra/" target="_blank" rel="noopener">Spectra<span class="visually-hidden"> {{t "Opens in a new tab"}}</span></a></p>
                <p><a href="https://ghost.org" target="_blank" rel="noopener">{{t "Published with Ghost"}}</a></p>
            </div>
        </div>
    </div>
</footer>
