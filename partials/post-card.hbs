<article class="card {{post_class}}" style="view-transition-name: card-{{id}}">
    {{#if feature_image}}
        <a class="card-image-link" href="{{url}}" tabindex="-1" aria-hidden="true">
            <img
                class="card-image"
                srcset="{{img_url feature_image size="s"}} 320w,
                        {{img_url feature_image size="m"}} 640w,
                        {{img_url feature_image size="l"}} 960w"
                sizes="(min-width: 48rem) 36rem, 100vw"
                src="{{img_url feature_image size="m"}}"
                alt=""
                loading="lazy"
            >
        </a>
    {{/if}}

    <div class="card-body">
        <h3 class="card-title" style="view-transition-name: title-{{id}}"><a href="{{url}}">{{title}}</a></h3>

        <p class="card-excerpt">{{excerpt words="28"}}</p>

        {{> post-meta card=true}}
    </div>
</article>
