{{!< default}}

<section class="container-narrow section error">
    <p class="eyebrow">404</p>
    <h1 class="article-title">{{t "Page not found"}}</h1>
    <p class="article-excerpt">{{t "The page you are looking for does not exist or has moved."}}</p>
    <p><a class="button" href="{{@site.url}}">{{t "Back to home"}}</a></p>
</section>

{{#get "posts" limit="3"}}
    {{#if posts}}
        <section class="container section">
            <header class="section-header">
                <h2 class="section-title">{{t "Latest posts"}}</h2>
            </header>
            <div class="feed">
                {{#foreach posts}}
                    {{> post-card}}
                {{/foreach}}
            </div>
        </section>
    {{/if}}
{{/get}}
